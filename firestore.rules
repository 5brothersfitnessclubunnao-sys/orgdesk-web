rules_version = '2';
// OrgDesk — multi-organisation rules. Every organisation's data lives under orgs/{org}/...
// An organisation's owner/staff can read and write only their own organisation.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed()   { return request.auth != null; }
    function orgDoc(o)  { return get(/databases/$(database)/documents/orgs/$(o)); }
    function isOwner(o) { return signed() && orgDoc(o).data.ownerUid == request.auth.uid; }
    function isStaff(o) {
      return signed() && (isOwner(o)
        || exists(/databases/$(database)/documents/orgs/$(o)/staff/$(request.auth.uid)));
    }
    function str(v, n)  { return v is string && v.size() <= n; }

    // user -> organisation pointer (own record only; real access is decided by orgs/{o}.ownerUid and staff docs)
    match /users/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow write: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['orgId', 'role', 'name']);
    }

    match /orgs/{o} {
      // public profile (name, logo, plans, groups, terms, notice) is needed by the admission form and member card
      allow get: if true;
      allow list: if false;
      allow create: if signed()
        && o.matches('^[a-z0-9-]{3,30}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['gym', 'school', 'college']
        && str(request.resource.data.name, 80);
      allow update: if isOwner(o)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type;
      allow delete: if false;

      match /staff/{uid} {
        allow read: if signed() && (uid == request.auth.uid || isOwner(o));
        allow write: if isOwner(o);
      }

      // members: full details (health, address, phone) are visible to staff only
      match /members/{id} {
        allow get, list: if isStaff(o);
        allow create: if isStaff(o) || (
          request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
               'name','phone','kind','data','planId','planName','planPrice','planMonths','batchId','batchName',
               'joinDate','utr','termsVersion','termsAccepted','signName','status','createdAt','hasFiles'])
          && request.resource.data.kind == orgDoc(o).data.type
          && str(request.resource.data.name, 80)
          && str(request.resource.data.phone, 15)
          && str(request.resource.data.utr, 30)
          && str(request.resource.data.signName, 80)
          && request.resource.data.data is map
          && request.resource.data.data.size() <= 45
          && request.resource.data.termsAccepted == true
          && request.resource.data.createdAt == request.time);
        allow update, delete: if isStaff(o);
      }

      // photos / documents / signature (large base64) — staff read only
      match /files/{id} {
        allow get, list: if isStaff(o);
        allow create: if isStaff(o) || (
          request.resource.data.keys().hasOnly(['photo','idFront','idBack','doc1','doc2','doc3','doc4','sign','idType','payShot'])
          && (!('payShot' in request.resource.data) || str(request.resource.data.payShot, 150000))
          && (!('photo' in request.resource.data)   || str(request.resource.data.photo, 90000))
          && (!('idFront' in request.resource.data) || str(request.resource.data.idFront, 150000))
          && (!('idBack' in request.resource.data)  || str(request.resource.data.idBack, 150000))
          && (!('doc1' in request.resource.data)    || str(request.resource.data.doc1, 150000))
          && (!('doc2' in request.resource.data)    || str(request.resource.data.doc2, 150000))
          && (!('doc3' in request.resource.data)    || str(request.resource.data.doc3, 150000))
          && (!('doc4' in request.resource.data)    || str(request.resource.data.doc4, 150000))
          && (!('sign' in request.resource.data)    || str(request.resource.data.sign, 100000))
          && (!('idType' in request.resource.data)  || str(request.resource.data.idType, 40)));
        allow update, delete: if isStaff(o);
      }

      // member card: small public-by-id record (card id is an unguessable random id)
      match /cards/{id} {
        allow get: if true;
        allow list: if isStaff(o);
        allow write: if isStaff(o);
      }

      // attendance: staff, or the member herself/himself once per day while the card is active and not expired
      match /attendance/{aid} {
        allow read: if isStaff(o);
        allow write: if isStaff(o);
        allow create: if aid == request.resource.data.date + '_' + request.resource.data.memberId
          && request.resource.data.keys().hasOnly(['memberId','name','date','time','ts','batch','by'])
          && request.resource.data.by == 'member'
          && request.resource.data.ts == request.time
          && exists(/databases/$(database)/documents/orgs/$(o)/cards/$(request.resource.data.memberId))
          && get(/databases/$(database)/documents/orgs/$(o)/cards/$(request.resource.data.memberId)).data.status == 'active'
          && get(/databases/$(database)/documents/orgs/$(o)/cards/$(request.resource.data.memberId)).data.expiryTs > request.time;
      }

      // online fee requests from the member's Pay page: staff confirm them; the member can only create a pending request
      match /payreqs/{id} {
        allow read, update, delete: if isStaff(o);
        allow create: if isStaff(o) || (
          request.resource.data.keys().hasOnly(['memberId','name','code','planId','planName','amount','credit','utr','status','createdAt','hasShot'])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && str(request.resource.data.name, 80) && str(request.resource.data.utr, 30)
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 10000000
          && exists(/databases/$(database)/documents/orgs/$(o)/cards/$(request.resource.data.memberId))
          && get(/databases/$(database)/documents/orgs/$(o)/cards/$(request.resource.data.memberId)).data.status == 'active');
      }
      match /payfiles/{id} {
        allow read, update, delete: if isStaff(o);
        allow create: if isStaff(o) || (request.resource.data.keys().hasOnly(['shot']) && str(request.resource.data.shot, 150000));
      }
      match /payments/{pid}  { allow read, write: if isStaff(o); }
      match /counters/{cid}  { allow read, write: if isStaff(o); }

      match /{rest=**} { allow read, write: if false; }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
